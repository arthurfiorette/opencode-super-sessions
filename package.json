{
  "name": "opencode-super-sessions",
  "version": "0.4.1",
  "description": "Session browser overlay for the OpenCode V2 TUI, with archiving and pull request and issue tracking",
  "keywords": [
    "opencode",
    "plugin",
    "sessions",
    "github",
    "gitlab"
  ],
  "homepage": "https://github.com/arthurfiorette/opencode-super-sessions#readme",
  "bugs": {
    "url": "https://github.com/arthurfiorette/opencode-super-sessions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurfiorette/opencode-super-sessions.git"
  },
  "funding": "https://github.com/arthurfiorette/opencode-super-sessions?sponsor=1",
  "license": "MIT",
  "author": "Arthur Fiorette <me@arthur.place>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "pnpm lint-ci && pnpm build && pnpm test-types && pnpm test && pnpm test:integration && pnpm test:contract && pnpm test:tui && pnpm test:package",
    "demo": "pnpm build && node demo/start.mjs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint-ci": "biome ci .",
    "lint-fix": "biome check --write --unsafe .",
    "prepack": "pnpm build",
    "test": "pnpm build && tsx --test --test-timeout=60000 test/unit/*.test.ts",
    "test:contract": "pnpm build && tsx --test --test-timeout=60000 --test-force-exit test/contract/*.test.ts",
    "test:integration": "pnpm build && tsx --test --test-timeout=60000 --test-force-exit test/integration/*.test.ts",
    "test:package": "node scripts/check-package.mjs",
    "test:tui": "pnpm build && bun --conditions=browser test ./test/tui",
    "test-types": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/client": "2.2.7",
    "@opencode/plugin": "2.2.7",
    "@opencode/theme": "2.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arthurfiorette/biomejs-config": "^2.0.1",
    "@biomejs/biome": "^2.6.6",
    "@opencode/sdk": "2.2.7",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "@types/node": "^24.19.2",
    "solid-js": "1.9.18",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.16"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24.16"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
